        "jobs",
        "career",
        "internship",
        "hiring",
        "salary"
      ],
      "action": "ai",
      "kbFilter": "placement"
    },
    {
      "id": "human_handover",
      "match": "regex",
      "priority": 45,
      "keywords": [
        "^(?:(?:hi|hello|ok|okay|please|pls|plz|sir|mam|maam|madam) )*(?:an? )?(?:agent|human|executive|counsell?or|real person|customer care|customer support|human agent|live agent)(?: (?:please|pls|plz|sir|mam|maam|madam))*$",
        "\\b(?:talk|speak|chat|connect|transfer|put)\\w* (?:me )?(?:to|with|through to) (?:an? |the |your |some )?(?:agent|human|executive|counsell?or|person|real person|someone|somebody|team|staff|customer care)\\b",
        "\\b(?:need|want|get|give me) (?:to (?:talk|speak) (?:to|with) )?(?:an? )?(?:agent|human|executive|counsell?or|real person|human agent|live agent)\\b",
        "\\b(?:human agent|live agent|real person)\\b",
        "\\b(?:call me|call back|callback)\\b"
      ],
      "action": "handover",
      "reply": "Sure {{name}} — I'm connecting you to our team. Someone will reply here shortly. 🙏\n\n(Type *bot* if you'd like to go back to the assistant.)",
      "_comment": "Only an explicit request for a person. A bare 'agent' anywhere used to fire on 'what agent fees' and 'an executive will call?'."
    },
    {
      "id": "resume_bot",
      "match": "exact",
      "keywords": [
        "bot",
        "assistant",
        "restart bot"
      ],
      "action": "resume",
      "reply": "I'm back! 🤖 What would you like to know?"
    },
    {
      "id": "thanks",
      "match": "contains",
      "keywords": [
        "thanks",
        "thank you",
        "thank u",
        "tq",
        "nandri",
        "dhanyavad"
      ],
      "action": "reply",
      "reply": "Happy to help, {{name}}! 😊 Anything else you'd like to know?"
    },
    {
      "id": "bye",
      "match": "contains",
      "keywords": [
        "bye",
        "goodbye",
        "see you",
        "ok bye",
        "no thanks"
      ],
      "action": "reply",
      "reply": "Thank you for reaching out! Message us anytime. Have a great day 👋"
    },
    {
      "id": "stop",
      "match": "exact",
      "keywords": [
        "stop",
        "unsubscribe",
        "opt out"
      ],
      "action": "optout"
    }
