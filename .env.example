# ---------- WATI ----------
# From WATI dashboard -> API Docs. Looks like: https://live-mt-server.wati.io/123456
WATI_API_ENDPOINT=https://live-mt-server.wati.io/<TENANT_ID>
# The long JWT shown as "Access Token" (paste WITHOUT the leading "Bearer ")
# Aliases also accepted: WATI_API_TOKEN, WATI_TOKEN
WATI_ACCESS_TOKEN=

# ---------- OpenAI ----------
# Required. Answers every question and powers semantic knowledge-base search.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
# Optional OpenAI-compatible endpoint. Leave blank for direct OpenAI.
OPENAI_BASE_URL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---------- Database (conversations and lead scores) ----------
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=focas
# Collections are domain-prefixed to sit alongside the other FOCAS projects.
MONGODB_MESSAGES_COLLECTION=wati_messages
MONGODB_LEADS_COLLECTION=wati_leads
MONGODB_FEEDBACK_COLLECTION=wati_feedback
MONGODB_OPTINS_COLLECTION=wati_optins
# Leads who replied STOP; the bot never answers them again.
MONGODB_OPTOUTS_COLLECTION=wati_optouts
# Which group each campaign lead said they are sitting in January 2027.
MONGODB_CAMPAIGN_COLLECTION=wati_campaign
# Chats handed to a human agent, and until when the bot stays silent in them.
MONGODB_HANDOVERS_COLLECTION=wati_handovers
# WATI message ids already handled, so a retried webhook is not answered twice.
MONGODB_WEBHOOK_EVENTS_COLLECTION=wati_webhook_events

# ---------- Server ----------
PORT=3000
HOST=127.0.0.1
# Browser testing first. Enable only when ready to connect WATI.
WHATSAPP_ENABLED=false
# Safety net while testing on a live WATI account: comma-separated numbers with
# country code. The bot replies ONLY to these and ignores every other contact.
# Leave blank to reply to all inbound messages (full production).
WHATSAPP_ALLOWED_NUMBERS=
# Campaign opt-in. A lead that is NOT on the list above unlocks the bot for
# itself alone by sending one of these phrases (comma-separated, case- and
# punctuation-insensitive, matched anywhere in the message). The bot then
# replies to that one number for WHATSAPP_OPTIN_HOURS and still ignores everybody
# else. Leave empty to disable and make WHATSAPP_ALLOWED_NUMBERS the only way in.
WHATSAPP_UNLOCK_PHRASE=jan 2027, january 2027, your last attempt, join now, start your prep, registered with icai
# Hours of silence after which the bot turns off for a campaign lead. Every
# message the lead sends restarts the clock; once it runs out the bot stays quiet
# until they send the phrase again.
WHATSAPP_OPTIN_HOURS=48
# Most answers one number (outside the list above) gets per hour.
WHATSAPP_MAX_MESSAGES_PER_HOUR=60
# Shared secret - set it in production. The WATI webhook URL must then end with
# ?token=<this value>; without it anyone who finds the URL can post fake messages.
WEBHOOK_VERIFY_TOKEN=

# ---------- Bot behaviour ----------
BOT_NAME=FOCASEdu Assistant
# Reply with AI answer when no keyword matches (true) or send FALLBACK_MESSAGE (false)
AI_FALLBACK_ENABLED=true
FALLBACK_MESSAGE=Sorry, I did not understand that. Type *menu* to see what I can help with.
HANDOVER_MESSAGE=Sure - connecting you to a human agent. Please wait a moment.
# Minutes of inactivity before a conversation's memory is dropped
SESSION_TTL_MINUTES=30
# Minutes the bot stays silent after a human handover request; each agent message restarts it
HANDOVER_PAUSE_MINUTES=60
# WATI user (login email) a chat is assigned to when the lead asks for a person.
# Leave blank and nobody is notified.
HANDOVER_OPERATOR_EMAIL=
# auto: semantic search, with keyword fallback if embeddings are unavailable.
# lexical: use local keyword search without embedding API calls.
KB_SEARCH_MODE=auto
# Number of knowledge-base chunks fed to the model per answer
KB_TOP_K=6
# Minimum cosine similarity for a chunk to be considered relevant (0-1)
KB_MIN_SCORE=0.25
